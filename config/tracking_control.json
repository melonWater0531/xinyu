{
  "schema_version": 1,
  "description": "Tracking control parameters with explicit units. Phase 1B uses deadband, safe ROI, edge margin, smoothing, and motion-limit values; later lost/search fields remain reserved for Phase 1C. Missing or malformed config must not block startup and falls back to code defaults.",
  "defaults_source": "current hardcoded runtime behavior in core/orchestrator_v2.py",
  "units": {
    "center_deadband_x_ratio": "frame_width_ratio",
