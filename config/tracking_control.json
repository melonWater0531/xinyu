    "safe_roi_width_ratio": "frame_width_ratio",
    "safe_roi_height_ratio": "frame_height_ratio",
    "edge_margin_x_ratio": "frame_width_ratio",
    "edge_margin_y_ratio": "frame_height_ratio",
    "max_yaw_deg_per_sec": "degrees_per_second",
    "max_pitch_deg_per_sec": "degrees_per_second",
    "max_yaw_delta_deg_per_tick": "degrees",
    "max_pitch_delta_deg_per_tick": "degrees",
    "yaw_smoothing_alpha": "unit_interval",
    "pitch_smoothing_alpha": "unit_interval",
    "lost_hold_ms": "milliseconds",
    "search_after_ms": "milliseconds",
    "require_stable_frames": "frames",
    "search_sweep_deg": "degrees",
    "search_yaw_deg_per_sec": "degrees_per_second",
    "search_pitch_deg_per_sec": "degrees_per_second",
    "search_timeout_ms": "milliseconds"
  },
  "control": {
    "center_deadband_x_ratio": 0.05,
    "center_deadband_y_ratio": 0.06,
    "safe_roi_width_ratio": 0.84,
    "safe_roi_height_ratio": 0.84,
    "edge_margin_x_ratio": 0.08,
    "edge_margin_y_ratio": 0.08,
    "max_yaw_deg_per_sec": 16.7,
