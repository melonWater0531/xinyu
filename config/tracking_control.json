    "max_yaw_delta_deg_per_tick": 5.0,
    "max_pitch_delta_deg_per_tick": 3.0,
    "yaw_smoothing_alpha": 0.2,
    "pitch_smoothing_alpha": 0.2,
    "lost_hold_ms": 1200,
    "search_after_ms": 500,
    "require_stable_frames": 3,
    "search_sweep_deg": 35,
    "search_yaw_deg_per_sec": 180,
    "search_pitch_deg_per_sec": 0,
    "search_timeout_ms": 8000
  },
  "performance_budget": {
    "face_detection_hz": "8-15",
    "control_hz": "15-20",
    "telemetry_hz": "3-5",
    "embedding_hz": "0.5-2 or state-triggered",
